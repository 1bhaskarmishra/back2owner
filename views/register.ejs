<%- include("partials/header.ejs") %>

<div class="login_container">
    <form class="login-form" action="/register" method="POST">
        <h1 id="create-account">Create <br>your account</h1>
        <label for="name">Name</label>
        <input name="name" placeholder="Enter your name" id="name" class="login_info" required><br />
        <label for="email">Email Address</label>
        <input type="email" name="login_id" placeholder="Enter your email" id="email" class="login_info" required><br />
        <label for="password">Password</label>
        <input type="password" name="login_pass" placeholder="Enter your password" id="password" class="login_info" required><br>
        <button type="submit" id="button">Register</button>
        <p id="signUp">Already have an account? <a href="/login">Sign In</a></p>
    </form>

</div>
<script>
    document.getElementById("register").setAttribute("hidden", true);

</script>

<%- include("partials/footer.ejs") %>

